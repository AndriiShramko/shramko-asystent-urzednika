{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://shramko.example/schemas/canonical-profile-0.1.json",
  "title": "Profil kanoniczny interesanta (Canonical citizen profile)",
  "description": "One profile feeds every form. Pattern-only checks live here; checksum rules are named in 'x-validator' and implemented in code (see report section 3.2). Dates are ISO 8601 (YYYY-MM-DD); printing to forms uses form-descriptor transforms. Every leaf may carry provenance in the sibling object 'provenance' (see $defs/provenance).",
  "type": "object",
  "required": ["profile_version", "applicant"],
  "additionalProperties": false,
  "properties": {
    "profile_version": { "const": "0.1" },
    "profile_id": { "type": "string", "format": "uuid", "description": "Opaque id; never the PESEL." },
    "applicant": { "$ref": "#/$defs/person", "title": "Wnioskodawca / osoba, której dotyczy sprawa" },
    "household_members": {
      "type": "array", "title": "Domownicy i członkowie rodziny",
      "items": {
        "type": "object", "required": ["relation", "person"], "additionalProperties": false,
        "properties": {
          "relation": { "enum": ["malzonek", "partner", "dziecko", "rodzic", "rodzenstwo", "dziadek_babcia", "wnuk", "inny_krewny", "inna_osoba"], "title": "Stopień pokrewieństwa / relacja" },
          "person": { "$ref": "#/$defs/person" },
          "shares_address_with_applicant": { "type": "boolean", "title": "Wspólne gospodarstwo domowe" },
          "legal_guardian_is_applicant": { "type": "boolean", "title": "Wnioskodawca jest opiekunem prawnym" }
        }
      }
    },
    "proxy": {
      "type": "object", "title": "Pełnomocnik / przedstawiciel ustawowy", "additionalProperties": false,
      "properties": {
        "person": { "$ref": "#/$defs/person" },
        "relation_to_principal": { "type": "string", "title": "Stopień pokrewieństwa pełnomocnika", "maxLength": 60 },
        "basis": { "enum": ["pelnomocnictwo_pisemne", "pelnomocnictwo_do_protokolu", "przedstawiciel_ustawowy", "opiekun_prawny"], "title": "Podstawa umocowania" },
        "scope_text": { "type": "string", "title": "Zakres pełnomocnictwa", "maxLength": 500 },
        "valid_until": { "type": "string", "format": "date" },
        "stamp_duty_exempt": { "type": "boolean", "title": "Zwolnienie z opłaty skarbowej (małżonek, wstępny, zstępny, rodzeństwo)" }
      }
    },
    "property_owner": {
      "type": "object", "title": "Właściciel lokalu / podmiot z tytułem prawnym", "additionalProperties": false,
      "properties": {
        "kind": { "enum": ["osoba_fizyczna", "osoba_prawna", "wspolnota", "spoldzielnia", "gmina"] },
        "person": { "$ref": "#/$defs/person" },
        "organisation_name": { "type": "string", "maxLength": 200, "title": "Nazwa podmiotu" },
        "legal_title": { "enum": ["wlasnosc", "wspolwlasnosc", "najem", "uzyczenie", "spoldzielcze_prawo", "inny"], "title": "Tytuł prawny do lokalu" },
        "address": { "$ref": "#/$defs/address" }
      }
    },
    "business": {
      "type": "object", "title": "Przedsiębiorca / podmiot", "additionalProperties": false,
      "properties": {
        "name": { "type": "string", "title": "Firma / nazwa", "maxLength": 250 },
        "legal_form": { "type": "string", "title": "Forma prawna", "maxLength": 100 },
        "nip": { "type": "string", "title": "NIP", "pattern": "^[0-9]{10}$", "x-validator": "nip_checksum" },
        "regon": { "type": "string", "title": "REGON", "pattern": "^([0-9]{9}|[0-9]{14})$", "x-validator": "regon_checksum" },
        "krs": { "type": "string", "title": "KRS", "pattern": "^[0-9]{10}$" },
        "ceidg_active": { "type": "boolean", "title": "Wpis w CEIDG" },
        "seat_address": { "$ref": "#/$defs/address", "title": "Adres siedziby" },
        "pkd": { "type": "array", "title": "Kody PKD", "items": { "type": "string", "pattern": "^[0-9]{2}\\.[0-9]{2}\\.[A-Z]$" } },
        "size_class": { "enum": ["mikro", "maly", "sredni", "inny"], "title": "Wielkość przedsiębiorcy (zał. I rozp. KE 651/2014)" },
        "representatives": { "type": "array", "title": "Osoby uprawnione do reprezentacji", "items": { "$ref": "#/$defs/person" } },
        "bank_account": { "$ref": "#/$defs/iban" },
        "licences": { "type": "array", "title": "Posiadane zezwolenia i licencje", "items": { "type": "object", "properties": { "kind": { "type": "string" }, "number": { "type": "string" }, "valid_until": { "type": "string", "format": "date" } }, "additionalProperties": false } }
      }
    },
    "vehicles": {
      "type": "array", "title": "Pojazdy",
      "items": {
        "type": "object", "additionalProperties": false,
        "properties": {
          "vin": { "type": "string", "title": "Numer VIN / nadwozia", "pattern": "^[A-HJ-NPR-Z0-9]{17}$", "description": "17 znaków, bez I, O, Q. Starsze pojazdy mogą mieć inny numer: wtedy pole 'chassis_number'." },
          "chassis_number": { "type": "string", "maxLength": 30 },
          "registration_number": { "type": "string", "title": "Numer rejestracyjny", "pattern": "^[A-Z0-9]{3,8}$" },
          "make": { "type": "string", "title": "Marka", "maxLength": 50 },
          "model": { "type": "string", "title": "Model", "maxLength": 50 },
          "type_category": { "type": "string", "title": "Rodzaj / kategoria", "maxLength": 30 },
          "production_year": { "type": "integer", "minimum": 1900, "maximum": 2100, "title": "Rok produkcji" },
          "first_registration_date": { "type": "string", "format": "date" },
          "mass_kg": { "type": "integer", "minimum": 0, "title": "DMC (kg)" },
          "engine_cc": { "type": "integer", "minimum": 0 },
          "fuel": { "type": "string", "maxLength": 30 },
          "ownership_proof": { "type": "string", "title": "Dowód własności", "maxLength": 200 },
          "technical_inspection_valid_until": { "type": "string", "format": "date" },
          "vehicle_card_number": { "type": "string", "title": "Numer karty pojazdu", "maxLength": 30 },
          "registration_certificate_number": { "type": "string", "title": "Numer dowodu rejestracyjnego", "maxLength": 30 }
        }
      }
    },
    "real_estate": {
      "type": "array", "title": "Nieruchomości i obiekty budowlane",
      "items": {
        "type": "object", "additionalProperties": false,
        "properties": {
          "address": { "$ref": "#/$defs/address", "title": "Położenie" },
          "parcel_number": { "type": "string", "title": "Numer działki", "maxLength": 40 },
          "precinct": { "type": "string", "title": "Obręb ewidencyjny", "maxLength": 60 },
          "land_register_number": { "type": "string", "title": "Numer księgi wieczystej", "pattern": "^[A-Z]{2}[0-9][A-Z]/[0-9]{8}/[0-9]$", "x-validator": "kw_checksum" },
          "legal_title": { "enum": ["wlasnosc", "wspolwlasnosc", "uzytkowanie_wieczyste", "posiadanie_samoistne", "posiadanie_zalezne", "inny"], "title": "Tytuł prawny" },
          "share": { "type": "string", "title": "Udział", "pattern": "^[0-9]+/[0-9]+$|^1$" },
          "land_area_m2": { "type": "number", "minimum": 0 },
          "building_area_m2": { "type": "number", "minimum": 0 },
          "usable_area_m2": { "type": "number", "minimum": 0 },
          "usage_class": { "type": "string", "title": "Sposób korzystania", "maxLength": 100 },
          "acquisition_date": { "type": "string", "format": "date" }
        }
      }
    },
    "case": {
      "type": "object", "title": "Parametry sprawy (nie są częścią profilu trwałego)", "additionalProperties": false,
      "properties": {
        "life_situation_id": { "type": "string", "title": "Sytuacja życiowa", "maxLength": 80 },
        "office_id": { "type": "string", "title": "Urząd i komórka", "maxLength": 80 },
        "place": { "type": "string", "title": "Miejscowość (w nagłówku pisma)", "maxLength": 60 },
        "date": { "type": "string", "format": "date", "title": "Data pisma" },
        "subject_text": { "type": "string", "title": "Treść żądania / cel wniosku", "maxLength": 2000 },
        "period": { "type": "object", "title": "Okres (np. pobytu czasowego, deklaracji)", "properties": { "from": { "type": "string", "format": "date" }, "to": { "type": "string", "format": "date" } }, "additionalProperties": false },
        "consents": { "type": "object", "title": "Zgody", "additionalProperties": { "type": "boolean" } },
        "delivery_channel": { "enum": ["odbior_osobisty", "poczta", "epuap", "e_doreczenia", "e_mail", "mobywatel"], "title": "Forma odbioru odpowiedzi" },
        "attachments": { "type": "array", "title": "Załączniki", "items": { "type": "string", "maxLength": 200 } }
      }
    },
    "provenance": {
      "type": "object", "title": "Pochodzenie danych (ścieżka JSON Pointer -> źródło)",
      "additionalProperties": { "$ref": "#/$defs/provenance" }
    }
  },
  "$defs": {
    "provenance": {
      "type": "object", "required": ["source", "at"], "additionalProperties": false,
      "properties": {
        "source": { "enum": ["citizen_form", "clerk_typed", "id_scan_ocr", "mrz_reader", "mobywatel", "registry_lookup", "previous_case"] },
        "at": { "type": "string", "format": "date-time" },
        "verified_by_clerk": { "type": "boolean" },
        "confidence": { "type": "number", "minimum": 0, "maximum": 1 }
      }
    },
    "iban": { "type": "string", "title": "Numer rachunku (IBAN)", "pattern": "^(PL)?[0-9]{26}$", "x-validator": "iban_mod97", "description": "Polish NRB 26 digits with optional PL prefix; other SEPA IBANs: widen pattern to ^[A-Z]{2}[0-9]{2}[A-Z0-9]{11,30}$." },
    "postal_code": { "type": "string", "title": "Kod pocztowy", "pattern": "^[0-9]{2}-[0-9]{3}$" },
    "address": {
      "type": "object", "title": "Adres", "additionalProperties": false,
      "properties": {
        "country": { "type": "string", "title": "Kraj", "default": "POLSKA", "maxLength": 60 },
        "voivodeship": { "type": "string", "title": "Województwo", "maxLength": 40 },
        "county": { "type": "string", "title": "Powiat", "maxLength": 60 },
        "commune": { "type": "string", "title": "Gmina", "maxLength": 60 },
        "city": { "type": "string", "title": "Miejscowość", "maxLength": 60 },
        "city_district": { "type": "string", "title": "Dzielnica", "maxLength": 60 },
        "street": { "type": "string", "title": "Ulica", "maxLength": 80 },
        "house_number": { "type": "string", "title": "Numer domu", "pattern": "^[0-9]{1,5}[A-Za-z]?(/[0-9A-Za-z]{1,5})?$", "maxLength": 9 },
        "flat_number": { "type": "string", "title": "Numer lokalu", "pattern": "^[0-9A-Za-z/]{1,7}$", "maxLength": 7 },
        "postal_code": { "$ref": "#/$defs/postal_code" },
        "post_office": { "type": "string", "title": "Poczta", "maxLength": 60 },
        "teryt_simc": { "type": "string", "title": "SIMC miejscowości", "pattern": "^[0-9]{7}$" },
        "teryt_ulic": { "type": "string", "title": "ULIC ulicy", "pattern": "^[0-9]{5}$" }
      }
    },
    "identity_document": {
      "type": "object", "title": "Dokument tożsamości", "additionalProperties": false,
      "properties": {
        "type": { "enum": ["dowod_osobisty", "paszport", "karta_pobytu", "inny"], "title": "Rodzaj dokumentu" },
        "series_number": { "type": "string", "title": "Seria i numer", "pattern": "^[A-Z]{3}[0-9]{6}$|^[A-Z]{2}[0-9]{7}$|^[A-Z0-9]{6,12}$", "description": "Dowód osobisty: 3 litery + 6 cyfr (np. ABC123456), paszport: 2 litery + 7 cyfr, patrz validator.", "x-validator": "id_card_checksum_if_dowod_osobisty" },
        "issuing_authority": { "type": "string", "title": "Organ wydający", "maxLength": 120 },
        "issue_date": { "type": "string", "format": "date" },
        "expiry_date": { "type": "string", "format": "date" },
        "country": { "type": "string", "title": "Państwo wydania", "default": "PL" },
        "mrz": { "type": "array", "title": "Linie MRZ (surowe)", "items": { "type": "string", "pattern": "^[A-Z0-9<]{30,44}$" }, "maxItems": 3 }
      }
    },
    "person": {
      "type": "object", "title": "Osoba fizyczna", "additionalProperties": false,
      "required": ["surname", "given_names"],
      "properties": {
        "surname": { "type": "string", "title": "Nazwisko", "minLength": 1, "maxLength": 60, "pattern": "^[A-Za-zÀ-ɏ '.-]+$" },
        "family_name_at_birth": { "type": "string", "title": "Nazwisko rodowe", "maxLength": 60 },
        "given_names": { "type": "array", "title": "Imię (imiona)", "minItems": 1, "maxItems": 4, "items": { "type": "string", "maxLength": 40, "pattern": "^[A-Za-zÀ-ɏ '.-]+$" } },
        "father_name": { "type": "string", "title": "Imię ojca", "maxLength": 40 },
        "mother_name": { "type": "string", "title": "Imię matki", "maxLength": 40 },
        "mother_maiden_name": { "type": "string", "title": "Nazwisko rodowe matki", "maxLength": 60 },
        "pesel": { "type": ["string", "null"], "title": "Numer PESEL", "pattern": "^[0-9]{11}$", "x-validator": "pesel_checksum_and_birthdate", "description": "Checksum and consistency with birth.date are code rules; null for persons without PESEL (then birth.* are required)." },
        "nip": { "type": "string", "title": "NIP", "pattern": "^[0-9]{10}$", "x-validator": "nip_checksum" },
        "sex": { "enum": ["K", "M"], "title": "Płeć" },
        "birth": {
          "type": "object", "title": "Urodzenie", "additionalProperties": false,
          "properties": {
            "date": { "type": "string", "format": "date", "title": "Data urodzenia" },
            "place": { "type": "string", "title": "Miejsce urodzenia", "maxLength": 60 },
            "country": { "type": "string", "title": "Kraj urodzenia", "maxLength": 60 }
          }
        },
        "citizenship": { "type": "array", "title": "Obywatelstwo", "items": { "type": "string", "pattern": "^[A-Z]{2}$" } },
        "marital_status": { "enum": ["panna_kawaler", "zamezna_zonaty", "rozwiedziona_rozwiedziony", "wdowa_wdowiec", "separacja"], "title": "Stan cywilny" },
        "id_document": { "$ref": "#/$defs/identity_document" },
        "residence_address": { "$ref": "#/$defs/address", "title": "Adres zameldowania / zamieszkania" },
        "correspondence_address": { "$ref": "#/$defs/address", "title": "Adres do korespondencji" },
        "previous_residence_country": { "type": "string", "title": "Kraj poprzedniego miejsca zamieszkania", "maxLength": 60 },
        "contact": {
          "type": "object", "title": "Dane kontaktowe", "additionalProperties": false,
          "properties": {
            "mobile_phone": { "type": "string", "title": "Telefon komórkowy", "pattern": "^\\+?[0-9]{9,15}$" },
            "email": { "type": "string", "title": "Adres e-mail", "format": "email", "maxLength": 100 },
            "e_delivery_address": { "type": "string", "title": "Adres do e-Doręczeń", "pattern": "^AE:[A-Z]{2}-[0-9]{5}-[0-9]{5}-[A-Z]{5}-[0-9]{2}$" },
            "epuap_box": { "type": "string", "title": "Adres skrytki ePUAP", "maxLength": 100 }
          }
        },
        "education_level": { "type": "string", "maxLength": 60 },
        "occupation": { "type": "string", "maxLength": 100 },
        "disability_degree": { "enum": ["lekki", "umiarkowany", "znaczny"], "title": "Stopień niepełnosprawności (dane szczególnej kategorii - art. 9 RODO, tylko za zgodą)" }
      }
    }
  },
  "x-validators": {
    "pesel_checksum_and_birthdate": "weights 1,3,7,9,1,3,7,9,1,3 over first 10 digits; control = (10 - sum mod 10) mod 10 == digit 11. Birth date: YY=digits1-2, MM=digits3-4 with century code (01-12=1900s, 21-32=2000s, 41-52=2100s, 61-72=2200s, 81-92=1800s), DD=digits5-6; must equal birth.date when both present; digit 10 parity: odd=M, even=K must equal sex.",
    "nip_checksum": "weights 6,5,7,2,3,4,5,6,7 over first 9 digits; sum mod 11 == digit 10; remainder 10 is invalid.",
    "regon_checksum": "9 digits: weights 8,9,2,3,4,5,6,7, control = sum mod 11 (10 -> 0). 14 digits: first 9 valid, then weights 2,4,8,5,0,9,7,3,6,1,2,4,8, control = sum mod 11 (10 -> 0).",
    "id_card_checksum_if_dowod_osobisty": "Polish ID card (3 letters + 6 digits): positions 1-3 letters A=10..Z=35, positions 5-9 digits; weights 7,3,1,0,7,3,1,7,3 over the 9 characters (position 4 is the check digit, weight 0); sum of the 8 weighted characters mod 10 == position 4. Passports: no public checksum on the printed number, use MRZ check digits (ICAO 9303, weights 7,3,1).",
    "iban_mod97": "Move first 4 chars to the end, letters to numbers (A=10..Z=35), integer mod 97 == 1; for PL 26 digits prefix 'PL' first. Bank routing digits 3-10 of NRB have their own check digit (weights 3,9,7,1,3,9,7).",
    "kw_checksum": "Land register number: court code + 8 digits + control digit; control = sum of weights 1,3,7,1,3,7,1,3,7,1,3,7 over the 12 characters (letters mapped 0-9 = 0-9, X=10, A=11, B=12, C=13, D=14, E=15, F=16, G=17, H=18, I=19, J=20, K=21, L=22, M=23, N=24, O=25, P=26, R=27, S=28, T=29, U=30, W=31, Y=32, Z=33) mod 10."
  }
}
