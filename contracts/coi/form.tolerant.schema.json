{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/AndriiShramko/shramko-asystent-urzednika/contracts/coi/form.tolerant.schema.json",
  "title": "Form definition for import: TOLERANT profile (what the partner's own exports contain)",
  "description": "Profile 'tolerant': reads the partner's own exports (reference sets 1 and 5). Departs from the strict profile where those exports do: link ids that are not UUIDs (export 5), an option without techName (export 5), validation as an empty object instead of a list (export 1), the wrapper key minItemRows (export 1), a component without states (export 1), unknown keys, missing optional keys. Used only for reading; our own output is checked with form.schema.json (strict). tools/coi_lint.py --profile tolerant reports every strict-only finding as a WARN.",
  "type": "object",
  "required": ["title", "tabs", "flow"],
  "properties": {
    "title": { "type": "string", "minLength": 1, "maxLength": 255 },
    "tabs": { "type": "array", "minItems": 2, "items": { "$ref": "#/$defs/tab" } },
    "flow": {
      "type": "object",
      "required": ["links"],
      "properties": {
        "links": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["id", "source", "target"],
            "properties": {
              "id": { "type": "string", "minLength": 1 },
              "source": { "type": "string", "minLength": 1 },
              "target": { "type": "string", "minLength": 1 }
            }
          }
        }
      }
    }
  },
  "$defs": {
    "uuid": { "type": "string", "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$" },
    "tab": {
      "type": "object",
      "required": ["id", "title", "type", "questions"],
      "properties": {
        "id": { "$ref": "#/$defs/uuid" },
        "title": { "type": "string", "minLength": 1 },
        "type": { "enum": ["MAIN", "FINISH"] },
        "questions": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/sectionQuestion" } }
      }
    },
    "cell": {
      "type": "object",
      "required": ["x", "y", "rows", "cols", "field"],
      "properties": {
        "x": { "type": "integer", "minimum": 0 },
        "y": { "type": "integer", "minimum": 0 },
        "rows": { "type": "integer", "minimum": 1 },
        "cols": { "type": "integer", "minimum": 1 },
        "minItemRows": { "type": "integer", "minimum": 0 }
      }
    },
    "sectionQuestion": {
      "allOf": [
        { "$ref": "#/$defs/cell" },
        {
          "properties": {
            "field": {
              "allOf": [
                { "$ref": "#/$defs/fieldBase" },
                {
                  "required": ["repeatingSectionGrid"],
                  "properties": {
                    "type": { "enum": ["SECTION", "REPEATING_SECTION"] },
                    "title": { "type": "string", "minLength": 1 },
                    "repeatingSectionGrid": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/innerQuestion" } }
                  }
                }
              ]
            }
          }
        }
      ]
    },
    "innerQuestion": {
      "allOf": [
        { "$ref": "#/$defs/cell" },
        {
          "properties": {
            "field": {
              "allOf": [
                { "$ref": "#/$defs/fieldBase" },
                {
                  "properties": {
                    "type": {
                      "enum": ["TEXT_FIELD", "CHECKBOX", "NUMBER", "CONSENT_SECTION", "SELECT", "TEXTAREA",
                               "FILE_UPLOADER", "RADIO", "DATEPICKER", "TEXT_BLOCK", "INFO_SECTION"]
                    }
                  }
                }
              ]
            }
          }
        }
      ]
    },
    "fieldBase": {
      "type": "object",
      "required": ["id", "type", "techName"],
      "properties": {
        "id": { "$ref": "#/$defs/uuid" },
        "type": { "type": "string" },
        "techName": { "type": "string", "pattern": "^[a-z][a-z0-9_]*$" },
        "title": { "type": "string" },
        "description": { "type": "string" },
        "tooltipMessage": { "type": "string" },
        "readOnly": { "type": "boolean" },
        "questionOrder": { "type": "integer", "minimum": 0 },
        "multiLevelTree": { "type": "boolean" },
        "searchEnabled": { "type": "boolean" },
        "options": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["id", "name"],
            "properties": { "id": { "type": "string" }, "name": { "type": "string" }, "techName": { "type": "string" } }
          }
        },
        "validation": {
          "anyOf": [
            { "type": "array", "items": { "enum": ["REQUIRED", "EMAIL", "PESEL", "NIP", "REGON", "ZIP_CODE", "EPUAP", "ADE", "SERIAL_NUMBER_ID_CARD"] }, "uniqueItems": true },
            { "type": "object", "maxProperties": 0 }
          ]
        },
        "dictionaryName": { "type": "string" },
        "defaultValue": { "type": ["string", "array"] },
        "defaultValueType": { "enum": ["EXTERNAL_SYSTEM", ""] },
        "states": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["type", "query"],
            "properties": { "type": { "enum": ["SHOW", "READ_ONLY"] }, "query": { "type": "string", "minLength": 1 } }
          }
        },
        "consentSectionConfig": {
          "type": "object",
          "required": ["consents"],
          "properties": {
            "consents": {
              "type": "array", "minItems": 1,
              "items": { "type": "object", "required": ["description"], "properties": { "description": { "type": "string" }, "required": { "type": "boolean" } } }
            },
            "required": { "type": "boolean" },
            "files": { "type": "array" }
          }
        },
        "repeatingSectionGrid": { "type": "array" }
      }
    }
  }
}
