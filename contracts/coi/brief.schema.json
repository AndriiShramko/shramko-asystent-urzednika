{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/AndriiShramko/shramko-asystent-urzednika/contracts/coi/brief.schema.json",
  "$defs": {
    "Addressee": {
      "additionalProperties": false,
      "properties": {
        "status": {
          "enum": [
            "stated",
            "not_found",
            "ambiguous"
          ],
          "title": "Status",
          "type": "string"
        },
        "value": {
          "title": "Value",
          "type": "string"
        },
        "evidence": {
          "default": [],
          "items": {
            "$ref": "#/$defs/Evidence"
          },
          "title": "Evidence",
          "type": "array"
        },
        "kind": {
          "enum": [
            "office",
            "body"
          ],
          "title": "Kind",
          "type": "string"
        },
        "name": {
          "title": "Name",
          "type": "string"
        },
        "candidates": {
          "items": {
            "$ref": "#/$defs/OfficeCandidate"
          },
          "title": "Candidates",
          "type": "array"
        }
      },
      "required": [
        "status"
      ],
      "title": "Addressee",
      "type": "object"
    },
    "ApplicantExtra": {
      "additionalProperties": false,
      "properties": {
        "concept": {
          "enum": [
            "pesel",
            "nip",
            "regon",
            "zip_code",
            "email",
            "epuap",
            "ade",
            "id_card",
            "nrb",
            "krs",
            "kw",
            "parcel_id",
            "phone",
            "date",
            "amount_pln",
            "count",
            "area"
          ],
          "title": "Concept",
          "type": "string"
        },
        "party": {
          "enum": [
            "self",
            "other_person",
            "entity"
          ],
          "title": "Party",
          "type": "string"
        },
        "required": {
          "default": false,
          "title": "Required",
          "type": "boolean"
        }
      },
      "required": [
        "concept",
        "party"
      ],
      "title": "ApplicantExtra",
      "type": "object"
    },
    "ApplicantOption": {
      "additionalProperties": false,
      "description": "1.1: one way of applying: who the party is and, when someone acts for it, in which capacity.",
      "properties": {
        "key": {
          "maxLength": 60,
          "pattern": "^[a-z][a-z0-9_]*$",
          "title": "Key",
          "type": "string"
        },
        "party": {
          "enum": [
            "self",
            "other_person",
            "entity"
          ],
          "title": "Party",
          "type": "string"
        },
        "capacity": {
          "description": "Absent: the party applies in person.",
          "enum": [
            "pelnomocnik",
            "reprezentant",
            "przedstawiciel_ustawowy"
          ],
          "title": "Capacity",
          "type": "string"
        },
        "evidence": {
          "default": [],
          "items": {
            "$ref": "#/$defs/Evidence"
          },
          "title": "Evidence",
          "type": "array"
        }
      },
      "required": [
        "key",
        "party"
      ],
      "title": "ApplicantOption",
      "type": "object"
    },
    "Applicants": {
      "additionalProperties": false,
      "properties": {
        "status": {
          "enum": [
            "stated",
            "not_found",
            "ambiguous"
          ],
          "title": "Status",
          "type": "string"
        },
        "value": {
          "title": "Value",
          "type": "string"
        },
        "evidence": {
          "default": [],
          "items": {
            "$ref": "#/$defs/Evidence"
          },
          "title": "Evidence",
          "type": "array"
        },
        "self": {
          "default": false,
          "title": "Self",
          "type": "boolean"
        },
        "other_person": {
          "default": false,
          "title": "Other Person",
          "type": "boolean"
        },
        "entity": {
          "default": false,
          "title": "Entity",
          "type": "boolean"
        },
        "capacities": {
          "default": [],
          "items": {
            "enum": [
              "pelnomocnik",
              "reprezentant",
              "przedstawiciel_ustawowy"
            ],
            "type": "string"
          },
          "title": "Capacities",
          "type": "array"
        },
        "options": {
          "description": "1.1: the ways of applying as items, beside the flags.",
          "items": {
            "$ref": "#/$defs/ApplicantOption"
          },
          "title": "Options",
          "type": "array"
        }
      },
      "required": [
        "status"
      ],
      "title": "Applicants",
      "type": "object"
    },
    "Attachment": {
      "additionalProperties": false,
      "properties": {
        "label": {
          "minLength": 1,
          "title": "Label",
          "type": "string"
        },
        "covered_by": {
          "description": "Standard section that already asks for it, e.g. \"standard/pelnomocnictwo\".",
          "pattern": "^[a-z0-9_]+(/[a-z0-9_]+)*$",
          "title": "Covered By",
          "type": "string"
        },
        "required": {
          "default": false,
          "title": "Required",
          "type": "boolean"
        },
        "show_if": {
          "$ref": "#/$defs/Cond"
        },
        "evidence": {
          "default": [],
          "items": {
            "$ref": "#/$defs/Evidence"
          },
          "title": "Evidence",
          "type": "array"
        },
        "key": {
          "description": "1.1: stable key; the composer makes the id from it when present, from the label otherwise.",
          "maxLength": 60,
          "pattern": "^[a-z][a-z0-9_]*$",
          "title": "Key",
          "type": "string"
        }
      },
      "required": [
        "label"
      ],
      "title": "Attachment",
      "type": "object"
    },
    "BriefField": {
      "additionalProperties": false,
      "properties": {
        "key": {
          "maxLength": 60,
          "pattern": "^[a-z][a-z0-9_]*$",
          "title": "Key",
          "type": "string"
        },
        "label": {
          "minLength": 1,
          "title": "Label",
          "type": "string"
        },
        "type": {
          "enum": [
            "TEXT_FIELD",
            "CHECKBOX",
            "NUMBER",
            "CONSENT_SECTION",
            "SELECT",
            "TEXTAREA",
            "FILE_UPLOADER",
            "RADIO",
            "DATEPICKER",
            "TEXT_BLOCK",
            "INFO_SECTION"
          ],
          "title": "Type",
          "type": "string"
        },
        "concept": {
          "enum": [
            "pesel",
            "nip",
            "regon",
            "zip_code",
            "email",
            "epuap",
            "ade",
            "id_card",
            "nrb",
            "krs",
            "kw",
            "parcel_id",
            "phone",
            "date",
            "amount_pln",
            "count",
            "area"
          ],
          "title": "Concept",
          "type": "string"
        },
        "required": {
          "default": false,
          "title": "Required",
          "type": "boolean"
        },
        "required_basis": {
          "enum": [
            "paper",
            "substance",
            "inferred"
          ],
          "title": "Required Basis",
          "type": "string"
        },
        "hint": {
          "title": "Hint",
          "type": "string"
        },
        "options": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Options",
          "type": "array"
        },
        "length": {
          "minimum": 1,
          "title": "Length",
          "type": "integer"
        },
        "show_if": {
          "$ref": "#/$defs/Cond"
        },
        "candidate": {
          "title": "Candidate",
          "type": "string"
        },
        "conf": {
          "maximum": 1.0,
          "minimum": 0.0,
          "title": "Conf",
          "type": "number"
        },
        "evidence": {
          "default": [],
          "items": {
            "$ref": "#/$defs/Evidence"
          },
          "title": "Evidence",
          "type": "array"
        }
      },
      "required": [
        "key",
        "label",
        "type"
      ],
      "title": "BriefField",
      "type": "object"
    },
    "ClauseText": {
      "additionalProperties": false,
      "description": "W11 CLERK-S: the information clause as the paper prints it, so that the consent of the form can carry it.",
      "properties": {
        "paragraphs": {
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "title": "Paragraphs",
          "type": "array"
        },
        "origin": {
          "enum": [
            "native",
            "ocr",
            "flow"
          ],
          "title": "Origin",
          "type": "string"
        },
        "conf": {
          "description": "Lowest mean word confidence of a page the clause stands on; 1 for text that was not OCR.",
          "maximum": 1.0,
          "minimum": 0.0,
          "title": "Conf",
          "type": "number"
        },
        "evidence": {
          "default": [],
          "items": {
            "$ref": "#/$defs/Evidence"
          },
          "title": "Evidence",
          "type": "array"
        }
      },
      "required": [
        "paragraphs",
        "origin",
        "conf"
      ],
      "title": "ClauseText",
      "type": "object"
    },
    "Cond": {
      "additionalProperties": false,
      "description": "Predicate tree (design 6.7): exactly one of {field, is} | any_of | all_of | not.",
      "properties": {
        "field": {
          "maxLength": 60,
          "pattern": "^[a-z][a-z0-9_]*$",
          "title": "Field",
          "type": "string"
        },
        "is": {
          "title": "Is",
          "type": "string"
        },
        "any_of": {
          "items": {
            "$ref": "#/$defs/Cond"
          },
          "title": "Any Of",
          "type": "array"
        },
        "all_of": {
          "items": {
            "$ref": "#/$defs/Cond"
          },
          "title": "All Of",
          "type": "array"
        },
        "not": {
          "$ref": "#/$defs/Cond"
        }
      },
      "title": "Cond",
      "type": "object"
    },
    "Consent": {
      "additionalProperties": false,
      "properties": {
        "text": {
          "minLength": 1,
          "title": "Text",
          "type": "string"
        },
        "required": {
          "default": true,
          "title": "Required",
          "type": "boolean"
        },
        "evidence": {
          "default": [],
          "items": {
            "$ref": "#/$defs/Evidence"
          },
          "title": "Evidence",
          "type": "array"
        },
        "kind": {
          "default": "consent",
          "description": "1.1: consent (default) or a declaration the applicant affirms.",
          "enum": [
            "consent",
            "declaration"
          ],
          "title": "Kind",
          "type": "string"
        }
      },
      "required": [
        "text"
      ],
      "title": "Consent",
      "type": "object"
    },
    "Declarations": {
      "additionalProperties": false,
      "properties": {
        "consents": {
          "default": [],
          "items": {
            "$ref": "#/$defs/Consent"
          },
          "title": "Consents",
          "type": "array"
        },
        "clause": {
          "$ref": "#/$defs/Stated"
        },
        "clause_text": {
          "$ref": "#/$defs/ClauseText"
        }
      },
      "required": [
        "clause"
      ],
      "title": "Declarations",
      "type": "object"
    },
    "Disposition": {
      "additionalProperties": false,
      "description": "1.1: what became of one finder candidate, decided by the understanding step (design 5.4 fates).",
      "properties": {
        "candidate": {
          "minLength": 1,
          "title": "Candidate",
          "type": "string"
        },
        "fate": {
          "enum": [
            "FIELD",
            "MERGED",
            "STANDARD",
            "LEFT_OUT",
            "AWAITING_DECISION"
          ],
          "title": "Fate",
          "type": "string"
        },
        "key": {
          "description": "FIELD: key of the brief field or attachment it became.",
          "maxLength": 60,
          "pattern": "^[a-z][a-z0-9_]*$",
          "title": "Key",
          "type": "string"
        },
        "into": {
          "description": "MERGED: candidate it was merged into.",
          "minLength": 1,
          "title": "Into",
          "type": "string"
        },
        "why": {
          "description": "MERGED: why.",
          "enum": [
            "COMB_CELLS",
            "GROUP_MEMBER",
            "LINE_BLOCK",
            "SAME_ALTERNATIVE",
            "TABLE_ROW"
          ],
          "title": "Why",
          "type": "string"
        },
        "role": {
          "description": "STANDARD: role of the standard section, e.g. \"standard/twoje_dane\".",
          "pattern": "^[a-z0-9_]+(/[a-z0-9_]+)*$",
          "title": "Role",
          "type": "string"
        },
        "reason": {
          "description": "LEFT_OUT: reason code.",
          "enum": [
            "PAPER_INSTRUCTION",
            "COVERED_BY_STANDARD",
            "SIGNATURE_AND_DATE",
            "OFFICE_USE",
            "PAGE_FURNITURE",
            "GRAMMAR_VARIANT",
            "CLAUSE_LINKED",
            "EXPLANATION",
            "COMPUTED_VALUE"
          ],
          "title": "Reason",
          "type": "string"
        },
        "decision": {
          "description": "AWAITING_DECISION: id of the decision.",
          "minLength": 1,
          "title": "Decision",
          "type": "string"
        }
      },
      "required": [
        "candidate",
        "fate"
      ],
      "title": "Disposition",
      "type": "object"
    },
    "Dropped": {
      "additionalProperties": false,
      "description": "Something of the paper left out on purpose, with its reason (brief \"dropped\", meta \"omissions\").",
      "properties": {
        "what": {
          "minLength": 1,
          "title": "What",
          "type": "string"
        },
        "reason": {
          "enum": [
            "PAPER_INSTRUCTION",
            "COVERED_BY_STANDARD",
            "SIGNATURE_AND_DATE",
            "OFFICE_USE",
            "PAGE_FURNITURE",
            "GRAMMAR_VARIANT",
            "CLAUSE_LINKED",
            "EXPLANATION",
            "COMPUTED_VALUE"
          ],
          "title": "Reason",
          "type": "string"
        },
        "page": {
          "minimum": 1,
          "title": "Page",
          "type": "integer"
        },
        "runs": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Runs",
          "type": "array"
        },
        "count": {
          "minimum": 1,
          "title": "Count",
          "type": "integer"
        }
      },
      "required": [
        "what",
        "reason"
      ],
      "title": "Dropped",
      "type": "object"
    },
    "Evidence": {
      "additionalProperties": false,
      "description": "Where a statement comes from: a quote, and the place on the paper when it is known.\n\nRevision 1.1: a record may carry box and anchor together (an anchored text box), and may leave out the quote\nwhen it locates a drawn blank with a box or an anchor. A Stated value still needs a quote (see Stated).",
      "properties": {
        "page": {
          "minimum": 1,
          "title": "Page",
          "type": "integer"
        },
        "box": {
          "maxItems": 4,
          "minItems": 4,
          "prefixItems": [
            {
              "type": "number"
            },
            {
              "type": "number"
            },
            {
              "type": "number"
            },
            {
              "type": "number"
            }
          ],
          "title": "Box",
          "type": "array"
        },
        "anchor": {
          "description": "Place in a file without geometry: \"p[12]\", \"p[12]/cell[2,3]\", \"Arkusz1!B7\".",
          "minLength": 1,
          "title": "Anchor",
          "type": "string"
        },
        "runs": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Runs",
          "type": "array"
        },
        "quote": {
          "minLength": 1,
          "title": "Quote",
          "type": "string"
        },
        "candidate": {
          "title": "Candidate",
          "type": "string"
        },
        "spans": {
          "items": {
            "$ref": "#/$defs/Span"
          },
          "title": "Spans",
          "type": "array"
        }
      },
      "title": "Evidence",
      "type": "object"
    },
    "InputRef": {
      "additionalProperties": false,
      "properties": {
        "sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Sha256",
          "type": "string"
        },
        "format": {
          "enum": [
            "pdf",
            "doc",
            "docx",
            "ods",
            "xlsx",
            "jpeg",
            "png",
            "rtf",
            "xls",
            "txt",
            "heic"
          ],
          "title": "Format",
          "type": "string"
        }
      },
      "required": [
        "sha256",
        "format"
      ],
      "title": "InputRef",
      "type": "object"
    },
    "MatterSection": {
      "additionalProperties": false,
      "properties": {
        "title": {
          "minLength": 1,
          "title": "Title",
          "type": "string"
        },
        "role": {
          "pattern": "^[a-z0-9_]+(/[a-z0-9_]+)*$",
          "title": "Role",
          "type": "string"
        },
        "repeating": {
          "default": false,
          "title": "Repeating",
          "type": "boolean"
        },
        "show_if": {
          "$ref": "#/$defs/Cond"
        },
        "fields": {
          "items": {
            "$ref": "#/$defs/BriefField"
          },
          "minItems": 1,
          "title": "Fields",
          "type": "array"
        },
        "page_title": {
          "description": "1.1: title of the page this section opens, when it differs from the section title.",
          "minLength": 1,
          "title": "Page Title",
          "type": "string"
        },
        "hint": {
          "description": "1.1: description of the section.",
          "minLength": 1,
          "title": "Hint",
          "type": "string"
        }
      },
      "required": [
        "title",
        "role",
        "fields"
      ],
      "title": "MatterSection",
      "type": "object"
    },
    "OfficeCandidate": {
      "additionalProperties": false,
      "description": "W11 CLERK-S: one office the paper names outside an addressee block (a header, a stamp line, the clause).",
      "properties": {
        "kind": {
          "enum": [
            "office",
            "body"
          ],
          "title": "Kind",
          "type": "string"
        },
        "name": {
          "minLength": 1,
          "title": "Name",
          "type": "string"
        },
        "evidence": {
          "$ref": "#/$defs/Evidence"
        }
      },
      "required": [
        "kind",
        "name",
        "evidence"
      ],
      "title": "OfficeCandidate",
      "type": "object"
    },
    "ProposedFee": {
      "additionalProperties": false,
      "description": "1.1: a fee we propose (from a statute or a guide), kept apart from the paper's fee: it never turns a\n`not_found` fee into `stated` (brief.proposed_fee, meta proposals.fee).",
      "properties": {
        "value": {
          "minLength": 1,
          "title": "Value",
          "type": "string"
        },
        "why": {
          "minLength": 1,
          "title": "Why",
          "type": "string"
        },
        "evidence": {
          "default": [],
          "items": {
            "$ref": "#/$defs/Evidence"
          },
          "title": "Evidence",
          "type": "array"
        }
      },
      "required": [
        "value",
        "why"
      ],
      "title": "ProposedFee",
      "type": "object"
    },
    "Span": {
      "additionalProperties": false,
      "description": "Characters [start, end) of one run's text (Python string indices, end exclusive): a mark, a label or an\noption that shares its run with others (\"❑ pies ❑ suka\"). Revision 1.1. A whole run is still named by its id\nalone. That a span lies inside its run's text is checked against the page model (FinderOutput.check_spans).",
      "properties": {
        "run": {
          "minLength": 1,
          "title": "Run",
          "type": "string"
        },
        "start": {
          "minimum": 0,
          "title": "Start",
          "type": "integer"
        },
        "end": {
          "minimum": 1,
          "title": "End",
          "type": "integer"
        }
      },
      "required": [
        "run",
        "start",
        "end"
      ],
      "title": "Span",
      "type": "object"
    },
    "Stated": {
      "additionalProperties": false,
      "description": "A value the paper states, does not state, or states in competing ways (design 5.3).\n\nstated: evidence with at least one quote; not_found: no value and no evidence; ambiguous: the competing quotes.\nA value is never filled in without one of the three.",
      "properties": {
        "status": {
          "enum": [
            "stated",
            "not_found",
            "ambiguous"
          ],
          "title": "Status",
          "type": "string"
        },
        "value": {
          "title": "Value",
          "type": "string"
        },
        "evidence": {
          "default": [],
          "items": {
            "$ref": "#/$defs/Evidence"
          },
          "title": "Evidence",
          "type": "array"
        }
      },
      "required": [
        "status"
      ],
      "title": "Stated",
      "type": "object"
    },
    "Warning": {
      "additionalProperties": false,
      "description": "One honest gap: what, where, and the quotes that show it.",
      "properties": {
        "id": {
          "title": "Id",
          "type": "string"
        },
        "code": {
          "enum": [
            "NOT_A_FORM",
            "UNREADABLE_PART",
            "OCR_USED",
            "HIDDEN_SHEET",
            "ACTIVE_CONTENT",
            "FILLED_FORM",
            "SILENT_PAGE",
            "LABEL_NOT_FOUND",
            "LABEL_RAW",
            "AMBIGUOUS_GROUP",
            "UNRESOLVED_REFERENCE",
            "REQUIRED_INFERRED",
            "ADDRESSEE_CONFLICT",
            "COMPOSITE_UNRESOLVED",
            "INFERRED_SHAPE",
            "LOW_CONFIDENCE",
            "REQUIRED_WITHOUT_EVIDENCE",
            "CONDITION_NOT_WRITTEN",
            "SECTION_SPLIT",
            "REPEATING_FLATTENED",
            "STEP_NOTE_ADDED",
            "MARKUP_IN_LABEL",
            "TITLE_MISSING",
            "ADDRESSEE_MISSING",
            "APPLICANTS_ASSUMED",
            "SOLE_TRADER_AS_ENTITY",
            "CLAUSE_LINK_MISSING",
            "NO_MATTER",
            "EXTRA_NOT_PLACED",
            "MODEL_USED",
            "MODEL_FALLBACK",
            "MODEL_SKIPPED",
            "INPUT_NOTE",
            "LEDGER_NOT_CLOSED",
            "BRIEF_NOT_READ",
            "GATE_G5",
            "GATE_G6",
            "GATE_G7",
            "GATE_G8",
            "GATE_G9",
            "GATE_G10",
            "GATE_G11",
            "GATE_G12"
