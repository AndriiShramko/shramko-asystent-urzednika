{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/AndriiShramko/shramko-asystent-urzednika/contracts/coi/form.schema.json",
  "title": "Form definition for import: STRICT profile (what we emit)",
  "description": "Profile 'strict': what our converter writes (decisions D1, D3, D4, D7 in docs/03-plan/DECISIONS-forms-track.md). Top level exactly title, tabs, flow; no key outside the documented ones (plus multiLevelTree and searchEnabled, which both partner exports carry on SELECT); every component carries options, validation (always a list), readOnly, repeatingSectionGrid, states and tooltipMessage; ids are UUIDs; every option has a techName. The partner's own exports depart from this in a few places and are read with the sibling file form.tolerant.schema.json. Rules a schema cannot express are checked by tools/coi_lint.py.",
  "type": "object",
  "required": ["title", "tabs", "flow"],
  "additionalProperties": false,
  "properties": {
    "title": { "type": "string", "minLength": 1, "maxLength": 255 },
    "tabs": { "type": "array", "minItems": 2, "items": { "$ref": "#/$defs/tab" } },
    "flow": {
      "type": "object",
      "required": ["links"],
      "additionalProperties": false,
      "properties": {
        "links": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["id", "source", "target"],
            "additionalProperties": false,
            "properties": {
              "id": { "$ref": "#/$defs/uuid" },
              "source": { "$ref": "#/$defs/uuid" },
              "target": { "$ref": "#/$defs/uuid" }
            }
          }
        }
      }
    }
  },
  "$defs": {
    "uuid": { "type": "string", "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$" },
    "tab": {
      "type": "object",
      "required": ["id", "title", "type", "questions"],
      "additionalProperties": false,
      "properties": {
        "id": { "$ref": "#/$defs/uuid" },
        "title": { "type": "string", "minLength": 1 },
        "type": { "enum": ["MAIN", "FINISH"] },
        "questions": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/sectionQuestion" } }
      }
    },
    "cell": {
      "type": "object",
      "required": ["x", "y", "rows", "cols", "field"],
      "additionalProperties": false,
      "properties": {
        "x": { "type": "integer", "minimum": 0 },
        "y": { "type": "integer", "minimum": 0 },
        "rows": { "type": "integer", "minimum": 1 },
        "cols": { "type": "integer", "minimum": 1 },
        "field": { "type": "object" }
      }
    },
    "sectionQuestion": {
      "description": "Top level of a page: only sections. Every other component lives inside one.",
      "allOf": [
        { "$ref": "#/$defs/cell" },
        {
          "properties": {
            "field": {
              "allOf": [
                { "$ref": "#/$defs/fieldBase" },
                {
                  "required": ["repeatingSectionGrid"],
                  "properties": {
                    "type": { "enum": ["SECTION", "REPEATING_SECTION"] },
                    "title": { "type": "string", "minLength": 1 },
                    "repeatingSectionGrid": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/innerQuestion" } }
                  }
                }
              ]
            }
          }
        }
      ]
    },
    "innerQuestion": {
      "description": "A component inside a section. Sections cannot be nested (D4): the grid of a component is empty.",
      "allOf": [
        { "$ref": "#/$defs/cell" },
        {
          "properties": {
            "field": {
              "allOf": [
                { "$ref": "#/$defs/fieldBase" },
                {
                  "properties": {
                    "type": {
                      "enum": ["TEXT_FIELD", "CHECKBOX", "NUMBER", "CONSENT_SECTION", "SELECT", "TEXTAREA",
                               "FILE_UPLOADER", "RADIO", "DATEPICKER", "TEXT_BLOCK", "INFO_SECTION"]
                    },
                    "repeatingSectionGrid": { "type": "array", "maxItems": 0 }
                  }
                }
              ]
            }
          }
        }
      ]
    },
    "fieldBase": {
      "type": "object",
      "required": ["id", "type", "techName", "options", "validation", "readOnly", "repeatingSectionGrid", "states", "tooltipMessage"],
      "additionalProperties": false,
      "properties": {
        "id": { "$ref": "#/$defs/uuid" },
        "type": { "type": "string" },
        "techName": { "type": "string", "pattern": "^[a-z][a-z0-9_]*$", "maxLength": 60 },
        "title": { "type": "string" },
        "description": { "type": "string" },
        "tooltipMessage": { "type": "string" },
        "readOnly": { "type": "boolean" },
        "questionOrder": { "type": "integer", "minimum": 0 },
        "multiLevelTree": { "type": "boolean" },
        "searchEnabled": { "type": "boolean" },
        "options": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["id", "name", "techName"],
            "properties": { "id": { "type": "string" }, "name": { "type": "string" }, "techName": { "type": "string" } }
          }
        },
        "validation": {
          "description": "Names of predefined validators, always a list (D3). The partner's export 1 has an empty object in three fields; we read it under the tolerant profile and never write it.",
          "type": "array",
          "items": { "enum": ["REQUIRED", "EMAIL", "PESEL", "NIP", "REGON", "ZIP_CODE", "EPUAP", "ADE", "SERIAL_NUMBER_ID_CARD"] },
          "uniqueItems": true
        },
        "dictionaryName": { "type": "string" },
        "defaultValue": { "type": ["string", "array"] },
        "defaultValueType": { "enum": ["EXTERNAL_SYSTEM", ""] },
        "states": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["type", "query"],
            "properties": { "type": { "enum": ["SHOW", "READ_ONLY"] }, "query": { "type": "string", "minLength": 1 } }
          }
        },
        "consentSectionConfig": {
          "type": "object",
          "required": ["consents"],
          "properties": {
            "consents": {
              "type": "array", "minItems": 1,
              "items": { "type": "object", "required": ["description"], "properties": { "description": { "type": "string" }, "required": { "type": "boolean" } } }
            },
            "required": { "type": "boolean" },
            "files": { "type": "array" }
          }
        },
        "repeatingSectionGrid": { "type": "array" }
      }
    }
  }
}
