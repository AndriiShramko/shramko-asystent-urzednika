{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/AndriiShramko/shramko-asystent-urzednika/contracts/coi/page-model.schema.json",
  "$defs": {
    "Cell": {
      "additionalProperties": false,
      "anyOf": [
        {
          "required": [
            "box"
          ]
        },
        {
          "required": [
            "anchor"
          ]
        }
      ],
      "properties": {
        "r": {
          "minimum": 0,
          "title": "R",
          "type": "integer"
        },
        "c": {
          "minimum": 0,
          "title": "C",
          "type": "integer"
        },
        "rs": {
          "default": 1,
          "minimum": 1,
          "title": "Rs",
          "type": "integer"
        },
        "cs": {
          "default": 1,
          "minimum": 1,
          "title": "Cs",
          "type": "integer"
        },
        "box": {
          "maxItems": 4,
          "minItems": 4,
          "prefixItems": [
            {
              "type": "number"
            },
            {
              "type": "number"
            },
            {
              "type": "number"
            },
            {
              "type": "number"
            }
          ],
          "title": "Box",
          "type": "array"
        },
        "anchor": {
          "description": "Place in a file without geometry: \"p[12]\", \"p[12]/cell[2,3]\", \"Arkusz1!B7\".",
          "minLength": 1,
          "title": "Anchor",
          "type": "string"
        },
        "runs": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Runs",
          "type": "array"
        },
        "borders": {
          "default": "",
          "description": "Drawn borders: any of t, r, b, l in this order.",
          "pattern": "^t?r?b?l?$",
          "title": "Borders",
          "type": "string"
        }
      },
      "required": [
        "r",
        "c"
      ],
      "title": "Cell",
      "type": "object"
    },
    "Evidence": {
      "additionalProperties": false,
      "description": "Where a statement comes from: a quote, and the place on the paper when it is known.\n\nRevision 1.1: a record may carry box and anchor together (an anchored text box), and may leave out the quote\nwhen it locates a drawn blank with a box or an anchor. A Stated value still needs a quote (see Stated).",
      "properties": {
        "page": {
          "minimum": 1,
          "title": "Page",
          "type": "integer"
        },
        "box": {
          "maxItems": 4,
          "minItems": 4,
          "prefixItems": [
            {
              "type": "number"
            },
            {
              "type": "number"
            },
            {
              "type": "number"
            },
            {
              "type": "number"
            }
          ],
          "title": "Box",
          "type": "array"
        },
        "anchor": {
          "description": "Place in a file without geometry: \"p[12]\", \"p[12]/cell[2,3]\", \"Arkusz1!B7\".",
          "minLength": 1,
          "title": "Anchor",
          "type": "string"
        },
        "runs": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Runs",
          "type": "array"
        },
        "quote": {
          "minLength": 1,
          "title": "Quote",
          "type": "string"
        },
        "candidate": {
          "title": "Candidate",
          "type": "string"
        },
        "spans": {
          "items": {
            "$ref": "#/$defs/Span"
          },
          "title": "Spans",
          "type": "array"
        }
      },
      "title": "Evidence",
      "type": "object"
    },
    "Line": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "minLength": 1,
          "title": "Id",
          "type": "string"
        },
        "box": {
          "maxItems": 4,
          "minItems": 4,
          "prefixItems": [
            {
              "type": "number"
            },
            {
              "type": "number"
            },
            {
              "type": "number"
            },
            {
              "type": "number"
            }
          ],
          "title": "Box",
          "type": "array"
        },
        "style": {
          "default": "solid",
          "enum": [
            "solid",
            "dashed",
            "dotted"
          ],
          "title": "Style",
          "type": "string"
        }
      },
      "required": [
        "id",
        "box"
      ],
      "title": "Line",
      "type": "object"
    },
    "Page": {
      "additionalProperties": false,
      "properties": {
        "number": {
          "minimum": 1,
          "title": "Number",
          "type": "integer"
        },
        "width": {
          "exclusiveMinimum": 0,
          "title": "Width",
          "type": "number"
        },
        "height": {
          "exclusiveMinimum": 0,
          "title": "Height",
          "type": "number"
        },
        "origin": {
          "enum": [
            "native",
            "ocr",
            "flow"
          ],
          "title": "Origin",
          "type": "string"
        },
        "name": {
          "description": "Sheet name of a workbook page.",
          "title": "Name",
          "type": "string"
        },
        "hidden": {
          "default": false,
          "title": "Hidden",
          "type": "boolean"
        },
        "runs": {
          "default": [],
          "items": {
            "$ref": "#/$defs/Run"
          },
          "title": "Runs",
          "type": "array"
        },
        "lines": {
          "default": [],
          "items": {
            "$ref": "#/$defs/Line"
          },
          "title": "Lines",
          "type": "array"
        },
        "rects": {
          "default": [],
          "items": {
            "$ref": "#/$defs/Rect"
          },
          "title": "Rects",
          "type": "array"
        },
        "tables": {
          "default": [],
          "items": {
            "$ref": "#/$defs/Table"
          },
          "title": "Tables",
          "type": "array"
        },
        "widgets": {
          "default": [],
          "items": {
            "$ref": "#/$defs/Widget"
          },
          "title": "Widgets",
          "type": "array"
        },
        "pictures": {
          "description": "1.1: bounds of placed pictures (stamps, logos, scans) the source declares.",
          "items": {
            "maxItems": 4,
            "minItems": 4,
            "prefixItems": [
              {
                "type": "number"
              },
              {
                "type": "number"
              },
              {
                "type": "number"
              },
              {
                "type": "number"
              }
            ],
            "type": "array"
          },
          "title": "Pictures",
          "type": "array"
        },
        "ink": {
          "description": "1.1: whether the page shows anything at all; absent: not measured.",
          "title": "Ink",
          "type": "boolean"
        },
        "row_heights": {
          "description": "1.1: sheet row heights in points, by row index from 0.",
          "items": {
            "type": "number"
          },
          "title": "Row Heights",
          "type": "array"
        },
        "col_widths": {
          "description": "1.1: sheet column widths in points, by column index from 0.",
          "items": {
            "type": "number"
          },
          "title": "Col Widths",
          "type": "array"
        }
      },
      "required": [
        "number",
        "origin"
      ],
      "title": "Page",
      "type": "object"
    },
    "Rect": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "minLength": 1,
          "title": "Id",
          "type": "string"
        },
        "box": {
          "maxItems": 4,
          "minItems": 4,
          "prefixItems": [
            {
              "type": "number"
            },
            {
              "type": "number"
            },
            {
              "type": "number"
            },
            {
              "type": "number"
            }
          ],
          "title": "Box",
          "type": "array"
        }
      },
      "required": [
        "id",
        "box"
      ],
      "title": "Rect",
      "type": "object"
    },
    "Run": {
      "additionalProperties": false,
      "anyOf": [
        {
          "required": [
            "box"
          ]
        },
        {
          "required": [
            "anchor"
          ]
        }
      ],
      "properties": {
        "id": {
          "minLength": 1,
          "title": "Id",
          "type": "string"
        },
        "text": {
          "title": "Text",
          "type": "string"
        },
        "box": {
          "maxItems": 4,
          "minItems": 4,
          "prefixItems": [
            {
              "type": "number"
            },
            {
              "type": "number"
            },
            {
              "type": "number"
            },
            {
              "type": "number"
            }
          ],
          "title": "Box",
          "type": "array"
        },
        "anchor": {
          "description": "Place in a file without geometry: \"p[12]\", \"p[12]/cell[2,3]\", \"Arkusz1!B7\".",
          "minLength": 1,
          "title": "Anchor",
          "type": "string"
        },
        "size": {
          "description": "Font size in points, when the format gives it.",
          "exclusiveMinimum": 0,
          "title": "Size",
          "type": "number"
        },
        "bold": {
          "default": false,
          "title": "Bold",
          "type": "boolean"
        },
        "conf": {
          "default": 1.0,
          "description": "1 for native text; the OCR word confidence otherwise.",
          "maximum": 1.0,
          "minimum": 0.0,
          "title": "Conf",
          "type": "number"
        },
        "leader": {
          "description": "1.1: tab leader the source declares for this run's tab.",
          "enum": [
            "dots",
            "underscores",
            "none"
          ],
          "title": "Leader",
          "type": "string"
        },
        "region": {
          "description": "1.1: part of the page the source declares; absent: not declared.",
          "enum": [
            "body",
            "header",
            "footer",
            "footnote"
          ],
          "title": "Region",
          "type": "string"
        },
        "footnote": {
          "description": "1.1: id of the footnote, on its reference mark and on the runs of its text.",
          "minLength": 1,
          "title": "Footnote",
          "type": "string"
        }
      },
      "required": [
        "id",
        "text"
      ],
      "title": "Run",
      "type": "object"
    },
    "Source": {
      "additionalProperties": false,
      "properties": {
        "sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Sha256",
          "type": "string"
        },
        "format": {
          "enum": [
            "pdf",
            "doc",
            "docx",
            "ods",
            "xlsx",
            "jpeg",
            "png",
            "rtf",
            "xls",
            "txt",
            "heic"
          ],
          "title": "Format",
          "type": "string"
        },
        "reader": {
          "description": "Reader that made the model, e.g. \"pdf.native\".",
          "pattern": "^[a-z0-9_]+(\\.[a-z0-9_]+)*$",
          "title": "Reader",
          "type": "string"
        },
        "pages": {
          "minimum": 0,
          "title": "Pages",
          "type": "integer"
        }
      },
      "required": [
        "sha256",
        "format",
        "reader",
        "pages"
      ],
      "title": "Source",
      "type": "object"
    },
    "Span": {
      "additionalProperties": false,
      "description": "Characters [start, end) of one run's text (Python string indices, end exclusive): a mark, a label or an\noption that shares its run with others (\"❑ pies ❑ suka\"). Revision 1.1. A whole run is still named by its id\nalone. That a span lies inside its run's text is checked against the page model (FinderOutput.check_spans).",
      "properties": {
        "run": {
          "minLength": 1,
          "title": "Run",
          "type": "string"
        },
        "start": {
          "minimum": 0,
          "title": "Start",
          "type": "integer"
        },
        "end": {
          "minimum": 1,
          "title": "End",
          "type": "integer"
        }
      },
      "required": [
        "run",
        "start",
        "end"
      ],
      "title": "Span",
      "type": "object"
    },
    "Table": {
      "additionalProperties": false,
      "anyOf": [
        {
          "required": [
            "box"
          ]
        },
        {
          "required": [
            "anchor"
          ]
        }
      ],
      "properties": {
        "id": {
          "minLength": 1,
          "title": "Id",
          "type": "string"
        },
        "box": {
          "maxItems": 4,
          "minItems": 4,
          "prefixItems": [
            {
              "type": "number"
            },
            {
              "type": "number"
            },
            {
              "type": "number"
            },
            {
              "type": "number"
            }
          ],
          "title": "Box",
          "type": "array"
        },
        "anchor": {
          "description": "Place in a file without geometry: \"p[12]\", \"p[12]/cell[2,3]\", \"Arkusz1!B7\".",
          "minLength": 1,
          "title": "Anchor",
          "type": "string"
        },
        "cells": {
          "default": [],
          "items": {
            "$ref": "#/$defs/Cell"
          },
          "title": "Cells",
          "type": "array"
        },
        "region": {
          "description": "1.1: part of the page the source declares.",
          "enum": [
            "body",
            "header",
            "footer",
            "footnote"
          ],
          "title": "Region",
          "type": "string"
        }
      },
      "required": [
        "id"
      ],
      "title": "Table",
      "type": "object"
    },
    "Warning": {
      "additionalProperties": false,
      "description": "One honest gap: what, where, and the quotes that show it.",
      "properties": {
        "id": {
          "title": "Id",
          "type": "string"
        },
        "code": {
          "enum": [
            "NOT_A_FORM",
            "UNREADABLE_PART",
            "OCR_USED",
            "HIDDEN_SHEET",
            "ACTIVE_CONTENT",
            "FILLED_FORM",
            "SILENT_PAGE",
            "LABEL_NOT_FOUND",
            "LABEL_RAW",
            "AMBIGUOUS_GROUP",
            "UNRESOLVED_REFERENCE",
            "REQUIRED_INFERRED",
            "ADDRESSEE_CONFLICT",
            "COMPOSITE_UNRESOLVED",
            "INFERRED_SHAPE",
            "LOW_CONFIDENCE",
            "REQUIRED_WITHOUT_EVIDENCE",
            "CONDITION_NOT_WRITTEN",
            "SECTION_SPLIT",
            "REPEATING_FLATTENED",
            "STEP_NOTE_ADDED",
            "MARKUP_IN_LABEL",
            "TITLE_MISSING",
            "ADDRESSEE_MISSING",
            "APPLICANTS_ASSUMED",
            "SOLE_TRADER_AS_ENTITY",
            "CLAUSE_LINK_MISSING",
            "NO_MATTER",
            "EXTRA_NOT_PLACED",
            "MODEL_USED",
            "MODEL_FALLBACK",
            "MODEL_SKIPPED"
          ],
          "title": "Code",
          "type": "string"
        },
        "page": {
          "minimum": 1,
          "title": "Page",
          "type": "integer"
        },
        "box": {
          "maxItems": 4,
          "minItems": 4,
          "prefixItems": [
            {
              "type": "number"
            },
            {
              "type": "number"
            },
            {
              "type": "number"
            },
            {
              "type": "number"
            }
          ],
          "title": "Box",
          "type": "array"
        },
        "anchor": {
          "description": "Place in a file without geometry: \"p[12]\", \"p[12]/cell[2,3]\", \"Arkusz1!B7\".",
          "minLength": 1,
          "title": "Anchor",
          "type": "string"
        },
        "field": {
          "title": "Field",
          "type": "string"
        },
        "candidate": {
          "title": "Candidate",
          "type": "string"
        },
        "evidence": {
          "default": [],
          "items": {
            "$ref": "#/$defs/Evidence"
          },
          "title": "Evidence",
          "type": "array"
        },
        "detail": {
          "title": "Detail",
          "type": "string"
        }
      },
      "required": [
        "code"
      ],
      "title": "Warning",
      "type": "object"
    },
    "Widget": {
      "additionalProperties": false,
      "anyOf": [
        {
          "required": [
            "box"
          ]
        },
        {
          "required": [
            "anchor"
          ]
        }
      ],
      "properties": {
        "id": {
          "minLength": 1,
          "title": "Id",
          "type": "string"
        },
        "kind": {
          "enum": [
            "text",
            "checkbox",
            "radio",
            "choice",
            "date",
            "signature"
          ],
          "title": "Kind",
          "type": "string"
        },
        "name": {
          "title": "Name",
          "type": "string"
        },
        "box": {
          "maxItems": 4,
          "minItems": 4,
          "prefixItems": [
            {
              "type": "number"
            },
            {
              "type": "number"
            },
            {
              "type": "number"
            },
            {
              "type": "number"
            }
          ],
          "title": "Box",
          "type": "array"
        },
        "anchor": {
          "description": "Place in a file without geometry: \"p[12]\", \"p[12]/cell[2,3]\", \"Arkusz1!B7\".",
          "minLength": 1,
          "title": "Anchor",
          "type": "string"
        },
        "max_len": {
          "minimum": 1,
          "title": "Max Len",
          "type": "integer"
        },
        "comb": {
          "default": false,
          "title": "Comb",
          "type": "boolean"
        },
        "options": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Options",
          "type": "array"
        },
        "field": {
          "description": "1.1: reference of the field this widget is one of (the radio group's shared field).",
          "minLength": 1,
          "title": "Field",
          "type": "string"
        },
        "values": {
          "description": "1.1: display and export value of each option, when they differ or are declared.",
          "items": {
            "$ref": "#/$defs/WidgetValue"
          },
          "title": "Values",
          "type": "array"
        },
        "on_state": {
          "description": "1.1: the value a checkbox or radio button takes when on.",
          "minLength": 1,
          "title": "On State",
          "type": "string"
        }
      },
      "required": [
        "id",
        "kind"
      ],
      "title": "Widget",
      "type": "object"
    },
    "WidgetValue": {
      "additionalProperties": false,
      "description": "1.1: one option of a widget as the file declares it: the text shown and the value exported.",
      "properties": {
        "display": {
          "title": "Display",
          "type": "string"
        },
        "export": {
          "title": "Export",
          "type": "string"
        }
      },
      "required": [
        "display",
        "export"
      ],
      "title": "WidgetValue",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "Page model, output of every reader (design 5.1). Also checked by app.model.page: page numbers 1..n, source.pages equals the page count, ids unique in the document, every element of a flow page has an anchor and of a native or ocr page a box (1.1: the other may be given too), a flow page carries lines, rects or pictures only with its size, table cells name runs of their page. Revision 1.1, additive.",
  "properties": {
    "model_version": {
      "default": 1.1,
      "description": "Revision of this contract; 1 (1.0) still validates.",
      "enum": [
        1,
        1.1
      ],
      "title": "Model Version"
    },
    "source": {
      "$ref": "#/$defs/Source"
    },
    "pages": {
      "items": {
        "$ref": "#/$defs/Page"
      },
      "title": "Pages",
      "type": "array"
    },
    "warnings": {
      "default": [],
      "items": {
        "$ref": "#/$defs/Warning"
      },
      "title": "Warnings",
      "type": "array"
    }
  },
  "required": [
    "source",
    "pages"
  ],
  "title": "PageModel",
  "type": "object"
}
